PORT=4000
HOST=0.0.0.0
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://chat:chat_local_password@localhost:5432/chat?schema=public

# 구글 로그인을 사용할 때 아래 세 항목을 함께 설정합니다.
# GOOGLE_CLIENT_ID=Google_OAuth_클라이언트_ID
# GOOGLE_CLIENT_SECRET=Google_OAuth_클라이언트_시크릿
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# 로컬 초대 메일은 외부로 발송하지 않고 http://localhost:8025 에서 확인합니다.
# 저장소 루트에서 pnpm mail:up 으로 Mailpit을 시작하세요.
INVITE_WEB_ORIGIN=http://localhost:3000
MAIL_MODE=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=chat@localhost.test

# 로컬 파일 저장소: pnpm storage:up (RustFS 관리 화면 http://localhost:9001)
# 개발 환경에서는 아래 기본값을 사용하므로 기존 .env를 수정하지 않아도 됩니다.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=chat-attachments
S3_ACCESS_KEY=chat-local
S3_SECRET_KEY=chat-local-storage-password

# 실제 메일은 MAIL_MODE=smtp 로 바꾸고 발송 서비스의 정보를 설정합니다.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=발송_계정
# SMTP_PASSWORD=발송_비밀번호
# MAIL_FROM=도메인에서_승인한_발신_이메일
# 465 포트의 TLS 연결은 SMTP_SECURE=true, 587 STARTTLS는 false입니다.
