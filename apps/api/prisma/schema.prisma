generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoomType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  MEMBER
}

enum ParticipantKind {
  MEMBER
  GUEST
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String?      @unique @db.VarChar(254)
  passwordHash String?      @map("password_hash")
  googleId     String?      @unique @map("google_id") @db.VarChar(255)
  displayName  String       @map("display_name") @db.VarChar(50)
  avatarUrl    String?      @map("avatar_url")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships RoomMember[]
  sessions     MemberSession[]
  invitations  Invitation[]

  @@map("users")
}

model ChatRoom {
  id            String       @id @default(uuid()) @db.Uuid
  type          RoomType
  name          String?      @db.VarChar(100)
  // 1:1 방 생성 시 정렬한 사용자 UUID 쌍으로 생성합니다.
  directKey     String?      @unique @map("direct_key")
  lastSeq       BigInt       @default(0) @map("last_seq")
  lastActivityAt DateTime     @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  members       RoomMember[]
  messages      Message[]
  invitations   Invitation[]

  @@index([lastActivityAt(sort: Desc)])
  @@map("chat_rooms")
}

model RoomMember {
  id          String          @id @default(uuid()) @db.Uuid
  roomId      String     @map("room_id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  kind        ParticipantKind @default(MEMBER)
  displayName String          @map("display_name") @db.VarChar(50)
  role        MemberRole @default(MEMBER)
  lastReadSeq BigInt     @default(0) @map("last_read_seq")
  joinedAt    DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt      DateTime?  @map("left_at") @db.Timestamptz(3)
  room        ChatRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages    Message[]
  guestSessions GuestSession[]
  acceptedInvitation Invitation?

  @@unique([roomId, userId])
  @@unique([roomId, id])
  @@index([userId])
  @@index([roomId, leftAt], map: "room_members_room_active_idx")
  @@map("room_members")
}

model Message {
  id              String   @id @default(uuid()) @db.Uuid
  roomId          String   @map("room_id") @db.Uuid
  senderMemberId  String   @map("sender_member_id") @db.Uuid
  clientMessageId String   @map("client_message_id") @db.Uuid
  seq             BigInt
  body            String   @db.VarChar(4000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  room            ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender          RoomMember @relation(fields: [roomId, senderMemberId], references: [roomId, id], onDelete: Restrict)
  attachments     Attachment[]

  @@unique([roomId, id])
  @@unique([roomId, seq])
  @@unique([roomId, senderMemberId, clientMessageId], map: "messages_room_sender_client_key")
  @@index([senderMemberId])
  @@map("messages")
}

model Attachment {
  id        String @id @default(uuid()) @db.Uuid
  roomId    String @map("room_id") @db.Uuid
  messageId String @unique @map("message_id") @db.Uuid
  objectKey String @unique @map("object_key")
  filename  String @db.VarChar(200)
  mimeType  String @map("mime_type") @db.VarChar(100)
  size      Int
  sha256    String @db.Char(64)
  message   Message @relation(fields: [roomId, messageId], references: [roomId, id], onDelete: Cascade, map: "attachments_message_fkey")

  @@map("attachments")
}

model MemberSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("member_sessions")
}

model GoogleLoginAttempt {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  codeVerifier String @map("code_verifier") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("google_login_attempts")
}

enum InvitationDeliveryStatus {
  SENDING
  SENT
  FAILED
}

enum InvitationDeliveryMode {
  LOCAL
  SMTP
  DISABLED
}

model Invitation {
  id                String   @id @default(uuid()) @db.Uuid
  roomId            String   @map("room_id") @db.Uuid
  inviterId         String   @map("inviter_id") @db.Uuid
  email             String   @db.VarChar(254)
  tokenHash         String   @unique @map("token_hash") @db.Char(64)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  acceptedMemberId  String?  @unique @map("accepted_member_id") @db.Uuid
  deliveryStatus    InvitationDeliveryStatus @map("delivery_status")
  deliveryMode      InvitationDeliveryMode @map("delivery_mode")
  deliveryAttemptId String   @map("delivery_attempt_id") @db.Uuid
  lastAttemptAt     DateTime @map("last_attempt_at") @db.Timestamptz(3)
  deliveryError     String?  @map("delivery_error") @db.VarChar(200)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  room              ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter           User     @relation(fields: [inviterId], references: [id], onDelete: Restrict)
  acceptedMember    RoomMember? @relation(fields: [roomId, acceptedMemberId], references: [roomId, id], onDelete: Restrict)

  @@unique([roomId, acceptedMemberId])
  @@index([roomId, createdAt])
  @@index([inviterId, lastAttemptAt])
  @@map("invitations")
}

model GuestSession {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  roomId    String   @map("room_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  member    RoomMember @relation(fields: [roomId, memberId], references: [roomId, id], onDelete: Cascade)

  @@index([memberId])
  @@index([expiresAt])
  @@map("guest_sessions")
}
